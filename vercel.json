{
  "functions": {
    "api/outlook-calendar.ts": { "maxDuration": 60 },
    "api/ticktick-trips.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/sync-monthly-backup", "schedule": "10 0 1 * *" }
  ],
  "rewrites": [
    { "source": "/api/bonclothes", "destination": "/api/outlook-calendar?app=bonclothes" },
    { "source": "/api/bonlife", "destination": "/api/outlook-calendar?app=bonlife" },
    { "source": "/api/notion-readinglist", "destination": "/api/outlook-calendar?app=notion-readinglist" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
